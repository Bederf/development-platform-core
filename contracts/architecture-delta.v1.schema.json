{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-delta.v1",
  "title": "Architecture Delta v1",
  "description": "Deterministic comparison of two architecture-graph.v1 projections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "delta_id", "graph_id", "before", "after", "generated_at", "added_nodes", "removed_nodes", "changed_nodes", "added_edges", "removed_edges", "changed_edges", "limitations", "digest"],
  "properties": {
    "schema": {"const": "architecture-delta.v1"},
    "delta_id": {"$ref": "#/$defs/id"},
    "graph_id": {"$ref": "#/$defs/id"},
    "before": {"$ref": "#/$defs/graph_ref"},
    "after": {"$ref": "#/$defs/graph_ref"},
    "generated_at": {"type": "string", "format": "date-time"},
    "added_nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "removed_nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "changed_nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/change"}},
    "added_edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "removed_edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "changed_edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/change"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "digest": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:[A-Za-z0-9_-]+$"},
    "graph_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["graph_id", "graph_version", "digest"],
      "properties": {
        "graph_id": {"$ref": "#/$defs/id"},
        "graph_version": {"$ref": "#/$defs/version"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "changes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "changes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["field", "before", "after"],
            "properties": {
              "field": {"type": "string", "minLength": 1},
              "before": {},
              "after": {}
            }
          }
        }
      }
    }
  }
}
