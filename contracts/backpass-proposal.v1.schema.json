{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backpass-proposal.v1",
  "title": "Backpass Instruction Improvement Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposal_id", "target", "hypothesis", "source_record_ids", "evidence_refs", "independence", "status", "created_at"],
  "properties": {
    "schema": {"const": "backpass-proposal.v1"},
    "proposal_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
    "target": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 2000},
    "source_record_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"}},
    "evidence_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,200}$"}},
    "independence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "method", "attested_record_ids"],
      "properties": {
        "status": {"const": "admissible"},
        "method": {"const": "distinct-attested-lineage-v1"},
        "attested_record_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"}}
      }
    },
    "status": {"const": "proposed"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
