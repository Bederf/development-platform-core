{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-startup-context.v1",
  "title": "AgentStartupContext v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "repository_root", "knowledge_root", "planning_root", "session", "repository_intelligence", "agents", "session_brief", "runtime_history"],
  "properties": {
    "schema": {"const": "agent-startup-context.v1"},
    "project_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "repository_root": {"type": "string", "minLength": 1},
    "knowledge_root": {"type": "string", "minLength": 1},
    "planning_root": {"type": "string", "minLength": 1},
    "current_objective": {"type": ["string", "null"]},
    "active_phase": {"type": ["string", "null"]},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "governance_reference": {"type": ["string", "null"]}
      }
    },
    "repository_intelligence": {"$ref": "repository-intelligence.v1.schema.json"},
    "agents": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "manifest_path", "reason", "selections"],
      "properties": {
        "schema": {"const": "development-capability-selection.v1"},
        "status": {"enum": ["resolved", "unavailable"]},
        "manifest_path": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]},
        "selections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "implementation", "version", "readiness", "adapter", "configuration"],
            "properties": {
              "enabled": {"type": "boolean"},
              "implementation": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "readiness": {"type": "string", "minLength": 1},
              "adapter": {"type": "string", "minLength": 1},
              "profiles": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "version"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "version": {"type": "string", "minLength": 1}
                  }
                }
              },
              "configuration": {"type": "object"}
            }
          }
        }
      }
    },
    "session_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "reason"],
      "properties": {
        "status": {"enum": ["accepted", "regenerated", "unavailable"]},
        "path": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "runtime_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recent_runs", "reason"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "recent_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "status", "started_at", "finished_at"],
            "properties": {
              "run_id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "started_at": {"type": "string", "minLength": 1},
              "finished_at": {"type": ["string", "null"]}
            }
          }
        },
        "reason": {"type": ["string", "null"]}
      }
    },
    "governance": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "acceptance_session": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "gsd_session": {"$ref": "gsd-session-governance.v1.schema.json"}
  }
}
