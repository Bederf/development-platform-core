{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsd-evaluation.v1",
  "title": "GSD Baseline Evaluation Contract v1",
  "description": "Evidence-backed comparison of a current GSD execution strategy with a candidate strategy before governance adoption.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "evaluation_id", "baseline", "candidate", "dataset", "metrics", "guardrails", "outcome", "recorded_at"],
  "properties": {
    "schema": {"const": "gsd-evaluation.v1"},
    "evaluation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},
    "baseline": {"$ref": "#/$defs/version_ref"}, "candidate": {"$ref": "#/$defs/version_ref"},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["training_refs", "held_out_refs"], "properties": {"training_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "held_out_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["metric", "baseline", "candidate", "direction", "evidence"], "properties": {"metric": {"type": "string", "minLength": 1}, "baseline": {"type": "number"}, "candidate": {"type": "number"}, "direction": {"enum": ["higher_is_better", "lower_is_better"]}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}}}},
    "guardrails": {"type": "object", "additionalProperties": false, "required": ["correctness_preserved", "verification_preserved", "evidence_complete", "regressions_within_limit"], "properties": {"correctness_preserved": {"type": "boolean"}, "verification_preserved": {"type": "boolean"}, "evidence_complete": {"type": "boolean"}, "regressions_within_limit": {"type": "boolean"}}},
    "outcome": {"enum": ["candidate_better", "equivalent", "baseline_better", "inconclusive", "rejected_by_guardrail"]},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "version_ref": {"type": "object", "additionalProperties": false, "required": ["id", "version", "graph_version", "profile"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "graph_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "profile": {"enum": ["small", "medium", "large"]}}}
  }
}
