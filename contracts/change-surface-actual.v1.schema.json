{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-surface-actual.v1",
  "title": "Actual Change Surface v1",
  "description": "Observed, versioned actual change-surface evidence for Forge comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "identity", "observation_digest", "revision", "changed_paths", "affected_components", "sensitive_dimensions", "unknown_dimensions", "complete"],
  "properties": {
    "schema": {"const": "change-surface-actual.v1"},
    "canonicalization": {"const": "json-sort-keys-separators-v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "observation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "revision": {"type": "string", "minLength": 1},
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "category"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "status": {"enum": ["added", "modified", "deleted", "renamed"]},
          "category": {"type": "string", "minLength": 1},
          "component": {"type": ["string", "null"]}
        }
      }
    },
    "affected_components": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sensitive_dimensions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unknown_dimensions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_context": {"oneOf": [{"$ref": "#/$defs/risk"}, {"type": "null"}]},
    "complete": {"type": "boolean"}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "phase_id", "work_id", "request_id", "attempt_id", "repository", "baseline"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "phase_id": {"type": "string", "minLength": 1},
        "work_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "baseline": {"type": "string", "minLength": 1}
      }
    },
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "blast_radius"],
      "properties": {
        "risk": {"enum": ["low", "medium", "high"]},
        "blast_radius": {"enum": ["low", "medium", "high"]}
      }
    }
  }
}
