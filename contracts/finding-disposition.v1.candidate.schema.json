{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-disposition.v1",
  "title": "Governed Finding Disposition v1",
  "description": "Candidate provider-neutral binding for operational finding review. Historical promotion evidence is retained separately; this artifact does not authorize, execute, verify, or mutate canonical state.",
  "oneOf": [
    { "$ref": "#/$defs/finding_review" },
    { "$ref": "#/$defs/operator_response" },
    { "$ref": "#/$defs/reviewer_disposition" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_type", "id", "version", "digest"],
      "properties": {
        "semantic_type": { "$ref": "#/$defs/id" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" },
        "scope_ref": { "$ref": "#/$defs/id" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_type", "scope_id"],
      "properties": {
        "scope_type": { "$ref": "#/$defs/id" },
        "scope_id": { "$ref": "#/$defs/id" },
        "project_ref": { "$ref": "#/$defs/ref" },
        "session_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "disposition_status": {
      "type": "string",
      "enum": ["REVIEW_PENDING", "NEEDS_CLARIFICATION", "DEFERRED", "REJECTED", "APPROVED"]
    },
    "common": {
      "type": "object",
      "required": ["schema", "entity_type", "entity_id", "version", "review_id", "revision", "scope", "lineage", "digest", "created_at"],
      "properties": {
        "schema": { "const": "finding-disposition.v1" },
        "entity_type": { "enum": ["finding_review", "operator_response", "reviewer_disposition"] },
        "entity_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "review_id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "lineage": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "digest": { "$ref": "#/$defs/digest" },
        "created_at": { "$ref": "#/$defs/time" }
      }
    },
    "review_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_type", "id", "version", "digest"],
      "properties": {
        "semantic_type": { "const": "finding_review" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "finding_review": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["entity_type", "finding_ref", "affected_subject_refs", "source_evidence_refs", "discovery_ref", "semantic_session_ref", "status"],
          "properties": {
            "entity_type": { "const": "finding_review" },
            "finding_ref": { "$ref": "#/$defs/ref" },
            "affected_subject_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
            "source_evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
            "discovery_ref": { "$ref": "#/$defs/ref" },
            "semantic_session_ref": { "$ref": "#/$defs/ref" },
            "operator_response_ref": { "$ref": "#/$defs/ref" },
            "reviewer_disposition_ref": { "$ref": "#/$defs/ref" },
            "correction_proposal_ref": { "$ref": "#/$defs/ref" },
            "status": { "$ref": "#/$defs/disposition_status" }
          },
          "x-invariants": [
            "finding, subject, evidence, discovery, and semantic-session references must be in compatible scope",
            "REVIEW_PENDING, NEEDS_CLARIFICATION, and DEFERRED cannot authorize correction or canonical mutation",
            "APPROVED permits proposal consideration only and never means policy allow, execution, verification, or catalog mutation",
            "operator response and reviewer disposition are separate attributable records",
            "a correction proposal must reference the approved review revision"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "operator_response": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["entity_type", "review_ref", "respondent_ref", "response_digest", "response_status", "responded_at"],
          "properties": {
            "entity_type": { "const": "operator_response" },
            "review_ref": { "$ref": "#/$defs/review_ref" },
            "respondent_ref": { "$ref": "#/$defs/ref" },
            "response_digest": { "$ref": "#/$defs/digest" },
            "response_status": { "enum": ["PROVIDED", "UNKNOWN", "DECLINED"] },
            "responded_at": { "$ref": "#/$defs/time" }
          },
          "x-invariants": [
            "response_digest binds operator-supplied context without making it authoritative",
            "operator response cannot establish reviewer approval or policy authorization"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "reviewer_disposition": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["entity_type", "review_ref", "reviewer_ref", "authority_ref", "disposition", "rationale_ref", "decided_at"],
          "properties": {
            "entity_type": { "const": "reviewer_disposition" },
            "review_ref": { "$ref": "#/$defs/review_ref" },
            "reviewer_ref": { "$ref": "#/$defs/ref" },
            "authority_ref": { "$ref": "#/$defs/ref" },
            "disposition": { "$ref": "#/$defs/disposition_status" },
            "rationale_ref": { "$ref": "#/$defs/ref" },
            "decided_at": { "$ref": "#/$defs/time" }
          },
          "x-invariants": [
            "reviewer_ref and authority_ref must identify an authorized reviewer boundary",
            "APPROVED is a review disposition and not a policy decision or execution authorization",
            "disposition changes require a new review revision and preserve prior decisions"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "x-status": "candidate-only",
  "x-promotion-record": "../docs/assurance/STAGE-04-FINDINGS-CLARIFICATIONS-PROMOTION-RECORD-v1.md"
}
