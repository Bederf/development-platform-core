{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dpc-owner-approval.v1",
  "title": "DPC Owner Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "approval_id", "decision", "subject", "issuer", "authority", "scope", "provenance", "recorded_at", "digest"],
  "properties": {
    "schema": {"const": "dpc-owner-approval.v1"},
    "approval_id": {"type": "string", "minLength": 1},
    "decision": {"const": "approved"},
    "subject": {"$ref": "#/$defs/subject"},
    "issuer": {"type": "string", "minLength": 1},
    "authority": {"const": "development-platform-core.owner"},
    "scope": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "recording_method"],
      "properties": {
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "recording_method": {"type": "string", "minLength": 1}
      }
    },
    "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "specification_id", "specification_version", "specification_hash"],
      "properties": {
        "phase_id": {"type": "string", "pattern": "^P[0-9]+$"},
        "specification_id": {"type": "string", "minLength": 1},
        "specification_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "specification_hash": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}
      }
    }
  }
}
