{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance-profile.v1",
  "title": "Risk-Based Governance Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "version", "work_profile", "impact_boundaries", "decisions", "review", "deferrals", "closeout"],
  "properties": {
    "schema": {"const": "governance-profile.v1"},
    "profile_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "work_profile": {"enum": ["documentation", "design", "implementation", "activation"]},
    "impact_boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["internal", "sensitive_data", "publication", "runtime_identity", "production_environment", "production_control"]}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "review": {"$ref": "#/$defs/review"},
    "deferrals": {"type": "array", "items": {"$ref": "#/$defs/deferral"}},
    "closeout": {"$ref": "#/$defs/closeout"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},
    "ref": {"type": "string", "minLength": 1},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "type", "status", "authority", "evidence_refs"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["technical_design", "evidence_acceptance", "contract_approval", "implementation_authorization", "production_activation"]},
        "status": {"enum": ["proposed", "accepted", "rejected", "deferred"]},
        "authority": {"$ref": "#/$defs/ref"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "status", "retry_limit"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "pending", "complete", "incomplete_review"]},
        "retry_limit": {"const": 1},
        "reviewer_ref": {"type": ["string", "null"]},
        "escalation_ref": {"type": ["string", "null"]}
      }
    },
    "deferral": {
      "type": "object", "additionalProperties": false,
      "required": ["deferral_id", "blocker", "safe_work", "prohibited_work", "owner", "revisit_condition"],
      "properties": {
        "deferral_id": {"$ref": "#/$defs/id"},
        "blocker": {"type": "string", "minLength": 1},
        "safe_work": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited_work": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner": {"$ref": "#/$defs/ref"},
        "revisit_condition": {"type": "string", "minLength": 1}
      }
    },
    "closeout": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "canonical_summary_ref", "superseded_refs"],
      "properties": {
        "status": {"enum": ["open", "closed"]},
        "canonical_summary_ref": {"type": ["string", "null"]},
        "superseded_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
      }
    }
  }
}
