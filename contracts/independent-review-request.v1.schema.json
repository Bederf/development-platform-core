{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "independent-review-request.v1",
  "title": "Independent Review Request v1",
  "description": "Provider-neutral request envelope for a GSD independent reviewer adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "task_ref",
    "revision_ref",
    "review_package",
    "reviewer_ref",
    "independence_required",
    "evidence_refs"
  ],
  "properties": {
    "schema": {"const": "independent-review-request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "task_ref": {"type": "string", "minLength": 1},
    "revision_ref": {"type": "string", "minLength": 1},
    "review_package": {"type": "string", "minLength": 1},
    "reviewer_ref": {"type": "string", "minLength": 1},
    "independence_required": {"const": true},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
