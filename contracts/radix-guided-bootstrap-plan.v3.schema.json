{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radix-guided-bootstrap-plan.v3",
  "x-status": "candidate-only",
  "title": "Radix Guided Bootstrap Plan v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "project_id", "repository_root", "selections", "generated_artifacts", "second_brain_vault", "limitations"],
  "properties": {
    "schema": {"const": "radix-guided-bootstrap-plan.v3"},
    "plan_id": {"const": "radix-guided-bootstrap"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "repository_root": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "constraints"],
      "properties": {
        "intent": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "application_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "selections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "enabled", "implementation", "version", "profiles"],
        "properties": {
          "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "enabled": {"const": true},
          "implementation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "profiles": {"type": "array", "items": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}}},
          "configuration": {"type": "object"}
        }
      }
    },
    "generated_artifacts": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "development-platform.yaml"}},
        {"contains": {"const": ".development-platform/capabilities.yaml"}},
        {"contains": {"const": "radix.sh"}}
      ]
    },
    "second_brain_vault": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["enabled", "path"], "properties": {"enabled": {"const": true}, "path": {"const": "knowledge-vault"}}},
        {"type": "object", "additionalProperties": false, "required": ["enabled", "path"], "properties": {"enabled": {"const": false}, "path": {"type": "null"}}}
      ]
    },
    "review_transport": {"type": "object"},
    "limitations": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
  }
}
