{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap-approval.v1",
  "title": "Bootstrap Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entity_type", "approval_id", "subject", "decision", "issuer", "authority_binding", "scope", "issued_at", "valid_until", "reason_codes"],
  "properties": {
    "schema": {"const": "bootstrap-approval.v1"},
    "entity_type": {"const": "bootstrap_approval"},
    "approval_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_type", "id", "version", "digest", "project_id"],
      "properties": {
        "semantic_type": {"const": "bootstrap_plan"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
        "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
      }
    },
    "decision": {"enum": ["approved", "rejected"]},
    "issuer": {"type": "string", "minLength": 1},
    "authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_type", "id", "version"],
      "properties": {
        "semantic_type": {"const": "approval_authority"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_type", "scope_id"],
      "properties": {
        "scope_type": {"type": "string", "minLength": 1},
        "scope_id": {"type": "string", "minLength": 1}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}}
  }
}
