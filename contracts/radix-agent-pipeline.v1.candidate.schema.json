{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radix-agent-pipeline.v1.candidate",
  "x-status": "candidate-only",
  "title": "Radix Agent Pipeline Candidate",
  "description": "Candidate provider-neutral hand-off contract for a bounded multi-agent pipeline. It does not authorize execution or define provider mechanics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pipeline_id", "version", "status", "project_ref", "source_ref", "roles", "stages", "approval_gate", "evidence_policy", "failure_policy"],
  "properties": {
    "schema": {"const": "radix-agent-pipeline.v1"},
    "pipeline_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["proposed", "approved", "blocked", "completed", "failed"]},
    "project_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "definition_id", "definition_version", "definition_digest"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "definition_id": {"type": "string", "minLength": 1},
        "definition_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "definition_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_root", "revision"],
      "properties": {
        "repository_root": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role_id", "responsibility", "input_artifacts", "output_artifacts"],
        "properties": {
          "role_id": {"enum": ["architect", "worker", "validator", "supervisor"]},
          "responsibility": {"type": "string", "minLength": 1},
          "input_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "output_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage_id", "role_id", "depends_on", "required_inputs", "outputs", "authorization_required"],
        "properties": {
          "stage_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "role_id": {"enum": ["architect", "worker", "validator", "supervisor"]},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "authorization_required": {"type": "boolean"},
          "authorization_ref": {
            "type": "object", "additionalProperties": false,
            "required": ["stage_id", "authority_ref", "decision", "evidence_ref", "digest"],
            "properties": {
              "stage_id": {"type": "string", "minLength": 1},
              "authority_ref": {"type": "string", "minLength": 1},
              "decision": {"const": "approved"},
              "evidence_ref": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"authorization_required": {"const": true}}},
          "then": {"required": ["authorization_ref"]}
        }]
      }
    },
    "approval_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["required_before", "authority_ref", "merge_allowed"],
      "properties": {
        "required_before": {"enum": ["execution", "merge", "promotion"]},
        "authority_ref": {"type": "string", "minLength": 1},
        "merge_allowed": {"type": "boolean"}
      }
    },
    "evidence_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["run_scoped", "content_addressed", "failure_is_terminal_or_blocked", "verification_authority"],
      "properties": {
        "run_scoped": {"const": true},
        "content_addressed": {"const": true},
        "failure_is_terminal_or_blocked": {"const": true},
        "verification_authority": {"type": "string", "minLength": 1}
      }
    },
    "failure_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "heartbeat_interval_seconds", "max_missed_heartbeats", "disconnect_outcome", "retry_allowed"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "heartbeat_interval_seconds": {"type": "integer", "minimum": 1},
        "max_missed_heartbeats": {"type": "integer", "minimum": 1},
        "disconnect_outcome": {"enum": ["blocked", "failed"]},
        "retry_allowed": {"const": false}
      }
    },
    "execution_provider_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "provider_version"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
