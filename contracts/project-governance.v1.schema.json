{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-governance.v1",
  "title": "Project Governance Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "context_id", "project_id", "repository_root", "status", "owner", "mandate", "authority", "review", "approval_policy", "provenance"],
  "properties": {
    "schema": {"const": "project-governance.v1"},
    "context_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "repository_root": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "confirmed", "reconciled", "revoked", "superseded"]},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "role", "confirmed_by", "confirmed_at"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "format": "date-time"}
      }
    },
    "mandate": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "scope", "exclusions"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["project_owner", "architecture", "engineering", "release", "operations"],
      "properties": {
        "project_owner": {"$ref": "#/$defs/authority"},
        "architecture": {"$ref": "#/$defs/authority"},
        "engineering": {"$ref": "#/$defs/authority"},
        "release": {"$ref": "#/$defs/authority"},
        "operations": {"$ref": "#/$defs/authority"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["independent_required", "authority_ref"],
      "properties": {
        "independent_required": {"type": "boolean"},
        "authority_ref": {"type": "string", "minLength": 1}
      }
    },
    "approval_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["lifecycle", "separate_decisions"],
      "properties": {
        "lifecycle": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "separate_decisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "delegations": {
      "type": "array", "items": {"$ref": "#/$defs/delegation"}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["recorded_at", "record_digest", "source"],
      "properties": {
        "recorded_at": {"type": "string", "format": "date-time"},
        "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "supersedes": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_ref", "decisions", "scope", "prohibited"],
      "properties": {
        "authority_ref": {"type": "string", "minLength": 1},
        "decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "delegation": {
      "type": "object", "additionalProperties": false,
      "required": ["delegation_id", "delegated_to", "scope", "expires_at", "revocable_by"],
      "properties": {
        "delegation_id": {"type": "string", "minLength": 1},
        "delegated_to": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "revocable_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
