{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radix-guided-bootstrap-plan.v1",
  "title": "Radix Guided Bootstrap Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "project_id", "repository_root", "selections", "generated_artifacts", "limitations"],
  "properties": {
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "constraints"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "application_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema": {"const": "radix-guided-bootstrap-plan.v1"},
    "plan_id": {"const": "radix-guided-bootstrap"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "repository_root": {"type": "string", "pattern": "^/[^\u0000]*$"},
    "selections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "enabled", "implementation", "version", "profiles"],
        "properties": {
          "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "enabled": {"const": true},
          "implementation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "profiles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
                "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
              }
            }
          },
          "configuration": {"type": "object"}
        }
      }
    },
    "generated_artifacts": {
      "const": ["development-platform.yaml", ".development-platform/capabilities.yaml"]
    },
    "review_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ocr"],
      "properties": {
        "ocr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "infisical_project_id", "infisical_env", "infisical_path"],
          "properties": {
            "transport": {"const": "omniroute"},
            "infisical_project_id": {"type": "string", "format": "uuid"},
            "infisical_env": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
            "infisical_path": {"type": "string", "pattern": "^/[^\\r\\n]*$"}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
