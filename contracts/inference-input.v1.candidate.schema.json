{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inference-input.v1",
  "title": "Inference input v1 Candidate",
  "$comment": "Candidate 1.0.0; not promoted. Structural validation does not establish authority, eligibility or semantic conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "input",
    "selected_model",
    "processing_destinations",
    "processing_constraints",
    "max_output_tokens",
    "disclosure_decision",
    "previous_execution"
  ],
  "properties": {
    "schema": {
      "const": "inference-input.v1"
    },
    "input": {
      "allOf": [
        {
          "$ref": "#/$defs/immutable_reference"
        },
        {
          "properties": {
            "semantic_type": {
              "const": "artifact"
            }
          }
        }
      ]
    },
    "selected_model": {
      "$ref": "#/$defs/immutable_reference"
    },
    "processing_destinations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/immutable_reference"
      }
    },
    "processing_constraints": {
      "$ref": "#/$defs/immutable_reference"
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "disclosure_decision": {
      "allOf": [
        {
          "$ref": "#/$defs/immutable_reference"
        },
        {
          "properties": {
            "semantic_type": {
              "const": "policy_decision"
            }
          }
        }
      ]
    },
    "previous_execution": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/immutable_reference"
            },
            {
              "properties": {
                "semantic_type": {
                  "const": "execution_result"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "immutable_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_type",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "semantic_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*:[A-Za-z0-9_-]+$"
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
