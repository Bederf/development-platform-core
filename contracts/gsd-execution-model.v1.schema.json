{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsd-execution-model.v1",
  "title": "GSD Governed Execution Model v1",
  "description": "Provider-neutral graph definitions, execution profiles, and fail-closed transition requests for governed engineering execution.",
  "oneOf": [
    {"$ref": "#/$defs/graph_definition"},
    {"$ref": "#/$defs/profile_selection"},
    {"$ref": "#/$defs/transition_request"},
    {"$ref": "#/$defs/transition_result"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "graph_definition": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "entity_type", "graph_id", "graph_version", "execution_dag", "lifecycle_graph", "invariants"],
      "properties": {
        "schema": {"const": "gsd-execution-model.v1"}, "entity_type": {"const": "graph_definition"},
        "graph_id": {"$ref": "#/$defs/id"}, "graph_version": {"$ref": "#/$defs/version"},
        "execution_dag": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges"], "properties": {
          "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}, "role": {"type": "string"}}}},
          "edges": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}}}}
        }},
        "lifecycle_graph": {"type": "object", "additionalProperties": false, "required": ["initial_state", "terminal_states", "transitions"], "properties": {
          "initial_state": {"$ref": "#/$defs/id"}, "terminal_states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
          "transitions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "required_evidence", "requires_authorization"], "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "required_evidence": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "requires_authorization": {"type": "boolean"}}}}
        }},
        "invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "profile_selection": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "entity_type", "selection_id", "profile", "factors", "source", "graph_ref"],
      "properties": {
        "schema": {"const": "gsd-execution-model.v1"}, "entity_type": {"const": "profile_selection"}, "selection_id": {"$ref": "#/$defs/id"}, "profile": {"enum": ["small", "medium", "large"]},
        "factors": {"type": "object", "additionalProperties": false, "minProperties": 1, "patternProperties": {"^[a-z][a-z0-9_]{0,63}$": {"type": "object", "additionalProperties": false, "required": ["level", "reason"], "properties": {"level": {"enum": ["low", "medium", "high"]}, "reason": {"type": "string", "minLength": 1}}}}},
        "source": {"enum": ["engine", "operator", "policy"]}, "graph_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "transition_request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "entity_type", "request_id", "graph_ref", "current_state", "requested_state", "ready_nodes", "authorization", "evidence"],
      "properties": {
        "schema": {"const": "gsd-execution-model.v1"}, "entity_type": {"const": "transition_request"}, "request_id": {"$ref": "#/$defs/id"}, "graph_ref": {"$ref": "#/$defs/ref"}, "current_state": {"$ref": "#/$defs/id"}, "requested_state": {"$ref": "#/$defs/id"}, "ready_nodes": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "authorization": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "transition_result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "entity_type", "request_id", "decision", "reason_codes", "evidence"],
      "properties": {
        "schema": {"const": "gsd-execution-model.v1"}, "entity_type": {"const": "transition_result"}, "request_id": {"$ref": "#/$defs/id"}, "decision": {"enum": ["allowed", "denied"]}, "reason_codes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
